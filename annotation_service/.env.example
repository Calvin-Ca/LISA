# API identity
ANNOTATION_SERVICE_VERSION=1.0.0

# Leave empty only for local contract testing. Configure a secret in deployment.
ANNOTATION_API_KEY=

# Comma-separated explicit frontend origins, without trailing slash.
ANNOTATION_CORS_ORIGINS=http://localhost:3000
ANNOTATION_CORS_ALLOW_CREDENTIALS=false

# HTTP and image limits. The request limit must exceed the image limit because
# multipart requests include headers and metadata.
ANNOTATION_MAX_REQUEST_BYTES=31457280
ANNOTATION_MAX_IMAGE_BYTES=20971520
ANNOTATION_MAX_IMAGE_PIXELS=25000000
ANNOTATION_MAX_METADATA_CHARS=16384

# Maximum jobs waiting for a GPU Worker. Idempotent retries do not consume
# additional queue capacity.
ANNOTATION_MAX_QUEUED_JOBS=100

# Expose /docs, /redoc, and /openapi.json.
ANNOTATION_DOCS_ENABLED=true

# SQLite metadata and controlled image/artifact storage. Keep this outside the
# source tree in deployment and mount it as persistent storage.
ANNOTATION_STORAGE_ENABLED=true
ANNOTATION_STORAGE_ROOT=./annotation-data

# GroundingDINO GPU Worker. Keep model files outside this repository. Relative
# model paths below are resolved from ANNOTATION_GROUNDING_DINO_ROOT.
ANNOTATION_GROUNDING_DINO_ROOT=../GroundingDINO
ANNOTATION_GROUNDING_DINO_CONFIG=groundingdino/config/GroundingDINO_SwinT_OGC.py
ANNOTATION_GROUNDING_DINO_CHECKPOINT=weights/groundingdino_swint_ogc.pth
ANNOTATION_GROUNDING_DINO_BERT=weights/bert-base-uncased
ANNOTATION_GROUNDING_DINO_DEVICE=cuda
ANNOTATION_GROUNDING_DINO_MODEL_VERSION=groundingdino-swint-ogc
ANNOTATION_GROUNDING_DINO_PROMPT_VERSION=construction-entities-v1
ANNOTATION_GROUNDING_DINO_BOX_THRESHOLD=0.35
ANNOTATION_GROUNDING_DINO_TEXT_THRESHOLD=0.25

# Worker queue lease. Heartbeat must be shorter than the lease.
ANNOTATION_WORKER_ID=grounding-dino-worker-1
ANNOTATION_WORKER_LEASE_SECONDS=300
ANNOTATION_WORKER_HEARTBEAT_SECONDS=60
ANNOTATION_WORKER_POLL_SECONDS=2

# SAM GPU Worker. Keep the checkpoint in MODEL_STORE; source code is imported
# from the repository's model.segment_anything package.
ANNOTATION_SAM_CHECKPOINT=../MODEL_STORE/sam/vit-h/upstream-4b8939-v1/sam_vit_h_4b8939.pth
ANNOTATION_SAM_MODEL_TYPE=vit_h
ANNOTATION_SAM_DEVICE=cuda
ANNOTATION_SAM_PYTHON_PACKAGE=model.segment_anything
ANNOTATION_SAM_MODEL_VERSION=sam-vit-h-4b8939
ANNOTATION_SAM_POLYGON_EPSILON=1.0
ANNOTATION_SAM_WORKER_ID=sam-worker-1
ANNOTATION_SAM_LEASE_SECONDS=300
ANNOTATION_SAM_HEARTBEAT_SECONDS=60
ANNOTATION_SAM_POLL_SECONDS=2

# Model-free ReasonSeg release worker.
ANNOTATION_RELEASE_WORKER_ID=release-worker-1
ANNOTATION_RELEASE_LEASE_SECONDS=300
ANNOTATION_RELEASE_HEARTBEAT_SECONDS=60
ANNOTATION_RELEASE_POLL_SECONDS=2

# Qwen2.5-VL Prompt Worker. Point this to an OpenAI-compatible vLLM /v1
# endpoint after the model service is available. The API process does not use
# these settings and can start while Qwen is offline.
ANNOTATION_QWEN_BASE_URL=http://127.0.0.1:18000/qwen25/v1
ANNOTATION_QWEN_MODEL=qwen25vl
ANNOTATION_QWEN_API_KEY=
ANNOTATION_QWEN_TIMEOUT_SECONDS=120
ANNOTATION_QWEN_MAX_TOKENS=1200
ANNOTATION_QWEN_FACTS_TEMPERATURE=0.1
ANNOTATION_QWEN_PROMPTS_TEMPERATURE=0.3
ANNOTATION_QWEN_WORKER_ID=qwen25vl-worker-1
ANNOTATION_QWEN_LEASE_SECONDS=300
ANNOTATION_QWEN_HEARTBEAT_SECONDS=60
ANNOTATION_QWEN_POLL_SECONDS=2

# Complete GroundingDINO -> SAM -> Qwen Worker. It reuses all model settings
# above and only claims jobs whose stop_after is omitted.
ANNOTATION_PIPELINE_WORKER_ID=full-pipeline-worker-1
ANNOTATION_PIPELINE_LEASE_SECONDS=900
ANNOTATION_PIPELINE_HEARTBEAT_SECONDS=60
ANNOTATION_PIPELINE_POLL_SECONDS=2

# The Worker always uses the local BERT directory above.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
